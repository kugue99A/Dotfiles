diff --git a/internal/limits/codexappserver.go b/internal/limits/codexappserver.go
new file mode 100644
index 0000000..224ad24
--- /dev/null
+++ b/internal/limits/codexappserver.go
@@ -0,0 +1,210 @@
+package limits
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os/exec"
+	"time"
+
+	"github.com/senna-lang/herdr-agent-usage/internal/planlabels"
+)
+
+const codexAppServerTimeout = 10 * time.Second
+
+// Codex 0.154+ exposes account/rateLimits/read through its local app-server.
+// Unlike rollout JSONL, this endpoint is backed by the current account state.
+type codexAppServerResponse struct {
+	ID     *int                  `json:"id"`
+	Result *codexAppServerResult `json:"result"`
+	Error  json.RawMessage       `json:"error"`
+}
+
+type codexAppServerResult struct {
+	RateLimits          *codexAppServerLimits            `json:"rateLimits"`
+	RateLimitsByLimitID map[string]*codexAppServerLimits `json:"rateLimitsByLimitId"`
+}
+
+type codexAppServerLimits struct {
+	Primary         *codexAppServerWindow          `json:"primary"`
+	Secondary       *codexAppServerWindow          `json:"secondary"`
+	IndividualLimit *codexAppServerIndividualLimit `json:"individualLimit"`
+	PlanType        *string                        `json:"planType"`
+}
+
+type codexAppServerWindow struct {
+	UsedPercent        *float64 `json:"usedPercent"`
+	WindowDurationMins *float64 `json:"windowDurationMins"`
+	ResetsAt           *float64 `json:"resetsAt"`
+}
+
+type codexAppServerIndividualLimit struct {
+	RemainingPercent *float64 `json:"remainingPercent"`
+	ResetsAt         *float64 `json:"resetsAt"`
+}
+
+func collectCodexAppServerLimits(providerID, label string, nowMs int64) (ProviderLimits, bool) {
+	limits, err := readCodexAppServerLimits()
+	if err != nil || limits == nil {
+		return ProviderLimits{}, false
+	}
+
+	out := ProviderLimits{
+		ProviderID:  providerID,
+		Label:       label,
+		PlanType:    planlabels.CodexPlanLabel(limits.PlanType),
+		Source:      "codex app-server",
+		FetchedAtMs: nowMs,
+	}
+	out.Primary = appServerWindow(limits.Primary)
+	out.Secondary = appServerWindow(limits.Secondary)
+	if out.Primary != nil || out.Secondary != nil {
+		return out, true
+	}
+
+	// Current Codex Business responses may omit primary/secondary while still
+	// exposing the live account quota. Keep that value, but label it as quota
+	// rather than guessing that it is a 5h or 7d window.
+	if individual := limits.IndividualLimit; individual != nil && individual.RemainingPercent != nil && isFiniteF(*individual.RemainingPercent) {
+		remaining := clampPercent(*individual.RemainingPercent)
+		window := &LimitWindow{
+			UsedPercentage: 100 - remaining,
+			WindowLabel:    "quota",
+		}
+		if individual.ResetsAt != nil && isFiniteF(*individual.ResetsAt) {
+			reset := int64(*individual.ResetsAt)
+			window.ResetsAt = &reset
+		}
+		out.Primary = window
+		return out, true
+	}
+	return ProviderLimits{}, false
+}
+
+func appServerWindow(raw *codexAppServerWindow) *LimitWindow {
+	if raw == nil || raw.UsedPercent == nil || !isFiniteF(*raw.UsedPercent) {
+		return nil
+	}
+	window := &LimitWindow{UsedPercentage: clampPercent(*raw.UsedPercent)}
+	if raw.WindowDurationMins != nil && isFiniteF(*raw.WindowDurationMins) {
+		minutes := int(*raw.WindowDurationMins)
+		window.WindowMinutes = &minutes
+	}
+	if raw.ResetsAt != nil && isFiniteF(*raw.ResetsAt) {
+		reset := int64(*raw.ResetsAt)
+		window.ResetsAt = &reset
+	}
+	return window
+}
+
+func clampPercent(value float64) float64 {
+	if value < 0 {
+		return 0
+	}
+	if value > 100 {
+		return 100
+	}
+	return value
+}
+
+func readCodexAppServerLimits() (*codexAppServerLimits, error) {
+	ctx, cancel := context.WithTimeout(context.Background(), codexAppServerTimeout)
+	defer cancel()
+
+	cmd, err := codexAppServerCommand(ctx)
+	if err != nil {
+		return nil, err
+	}
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		return nil, err
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		return nil, err
+	}
+	cmd.Stderr = io.Discard
+	if err := cmd.Start(); err != nil {
+		return nil, err
+	}
+
+	send := func(message any) error {
+		encoded, err := json.Marshal(message)
+		if err != nil {
+			return err
+		}
+		_, err = fmt.Fprintf(stdin, "%s\n", encoded)
+		return err
+	}
+	if err := send(map[string]any{
+		"id":     1,
+		"method": "initialize",
+		"params": map[string]any{
+			"clientInfo": map[string]string{
+				"name":    "herdr-agent-usage",
+				"title":   "Herdr Agent Usage",
+				"version": "0.5",
+			},
+			"capabilities": map[string]any{
+				"experimentalApi":    true,
+				"requestAttestation": false,
+			},
+		},
+	}); err != nil {
+		_ = cmd.Process.Kill()
+		return nil, err
+	}
+
+	scanner := bufio.NewScanner(stdout)
+	scanner.Buffer(make([]byte, 4096), 1024*1024)
+	var result *codexAppServerLimits
+	for scanner.Scan() {
+		var response codexAppServerResponse
+		if err := json.Unmarshal(scanner.Bytes(), &response); err != nil || response.ID == nil {
+			continue
+		}
+		switch *response.ID {
+		case 1:
+			if err := send(map[string]any{"method": "initialized", "params": map[string]any{}}); err != nil {
+				_ = cmd.Process.Kill()
+				return nil, err
+			}
+			if err := send(map[string]any{
+				"id":     2,
+				"method": "account/rateLimits/read",
+				"params": map[string]any{"excludeResetCreditDetails": true},
+			}); err != nil {
+				_ = cmd.Process.Kill()
+				return nil, err
+			}
+		case 2:
+			if response.Result != nil {
+				result = response.Result.RateLimits
+				if result == nil {
+					result = response.Result.RateLimitsByLimitID["codex"]
+				}
+			}
+			_ = stdin.Close()
+			_ = cmd.Wait()
+			return result, nil
+		}
+	}
+	_ = stdin.Close()
+	_ = cmd.Wait()
+	if err := scanner.Err(); err != nil {
+		return nil, err
+	}
+	return result, nil
+}
+
+func codexAppServerCommand(ctx context.Context) (*exec.Cmd, error) {
+	if codex, err := exec.LookPath("codex"); err == nil {
+		return exec.CommandContext(ctx, codex, "app-server", "--stdio"), nil
+	}
+	if mise, err := exec.LookPath("mise"); err == nil {
+		return exec.CommandContext(ctx, mise, "exec", "--", "codex", "app-server", "--stdio"), nil
+	}
+	return nil, fmt.Errorf("codex and mise are not available on PATH")
+}

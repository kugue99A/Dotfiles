			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#8B74A1</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>keyword, storage, storage.type, entity.name.tag</string>
			<key>settings</key>
